# 로컬 개발용 환경변수 템플릿.
# 사용:  Copy-Item .env.example .env   후 값 채우기. (.env 는 git 에 안 올라감)
# 운영(Cloud Run)은 Secret Manager 를 쓰므로 이 파일은 로컬 전용.

# --- 로컬 개발 동작 설정 (그대로 두면 됨) ---
FLASK_DEBUG=1                 # 편집 시 자동 리로드
DEV_LOGIN_ENABLED=1          # 구글 OAuth 없이 /auth/dev-login 으로 로그인 (FLASK_ENV!=production 일 때만)
SESSION_SECRET=local-dev-only-secret
USERS_DB_PATH=kdate_users.db # 로컬 SQLite (gitignore 됨)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
DAILY_FREE_QUOTA=10
QUOTA_TIMEZONE=Asia/Seoul

# --- 실제 키 (채팅/TTS 로컬 테스트하려면 필요. 화면만 볼 거면 비워도 됨) ---
GEMINI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
PROJECT_ID=
LOCATION=

# --- 선택: Google Sheets 로깅 (없으면 자동 비활성, 화면엔 영향 없음) ---
GOOGLE_SHEETS_CREDENTIALS=gcp-service-account.json
GOOGLE_SHEET_NAME=
